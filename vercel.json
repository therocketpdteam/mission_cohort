{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel:build",
  "crons": [
    {
      "path": "/api/jobs/sync-cohort-staff-invites",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/send-scheduled-communications?limit=50&jobVersion=2",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/process-crm-sync?limit=10&missionOnly=true&jobVersion=3",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-quickbooks-invoices?limit=50",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-jotform-submissions",
      "schedule": "35 * * * *"
    }
  ]
}
